{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agm.compiled_obligation/v0.2-dev",
  "title": "AGM vNext compiled obligation",
  "type": "object",
  "required": [
    "id",
    "obligation_id",
    "source_rule_ids",
    "type",
    "severity",
    "blocking",
    "verifier_roles",
    "evidence_type",
    "status"
  ],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "obligation_id": {"type": "string", "minLength": 1},
    "source_rule_ids": {"type": "array", "items": {"type": "string"}},
    "type": {"enum": ["evidence", "human_attestation", "maintainer_verification"]},
    "severity": {"enum": ["low", "medium", "high", "critical"]},
    "blocking": {"type": "boolean"},
    "verifier_roles": {"type": "array", "items": {"type": "string"}},
    "evidence_type": {"type": "string", "minLength": 1},
    "status": {"type": "string", "minLength": 1}
  }
}
